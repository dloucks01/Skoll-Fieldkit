+-- love.js (Web) workaround: on the emscripten LÖVE build, love.filesystem.read
+-- HANGS on a missing file rather than returning nil -- it logs "Could not open
+-- file X. Does not exist." and never returns, freezing the whole app before the
+-- first frame (the launcher's readiness probes read not-yet-created cache and
+-- options files on every boot). love.filesystem.getInfo is safe, so on Web gate
+-- every read behind an existence check. Contained to Web; native builds keep
+-- LÖVE's own read untouched.
+if love and love.system and love.system.getOS() == "Web" then
+  -- love.js runs Lua 5.1 with no LuaJIT `bit` module and no Lua 5.3 bitwise
+  -- operators, but the ROM extractor, save converter and audio synth all
+  -- require("bit"). Register a pure-Lua LuaBitOp-compatible equivalent under the
+  -- same module name before any of them load, so they run unchanged.
+  if not package.loaded["bit"] then
+    package.loaded["bit"] = require("src.compat.luabit")
+  end
+
+  local fs = love.filesystem
+  local realRead = fs.read
+  fs.read = function(...)
+    local a, b = ...
+    local name = (a == "string" or a == "data") and b or a
+    if type(name) == "string" and fs.getInfo(name, "file") == nil then
+      return nil, "File does not exist"
+    end
+    return realRead(...)
+  end
+end
+
